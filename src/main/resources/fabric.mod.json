	"authors": [
		"LOOOLLO"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/csgo-bot-vics-point-blank",
		"sources": "https://github.com/LOOOLLO/csgo-bot-vics-point-blank",
		"issues": "https://github.com/LOOOLLO/csgo-bot-vics-point-blank/issues"
	},
	"license": "ARR",
	"icon": "assets/csgo_mc/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.csgocompat.CsGoCompatMod"
		],
		"client": [
			"com.example.csgocompat.client.CsGoCompatModClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
